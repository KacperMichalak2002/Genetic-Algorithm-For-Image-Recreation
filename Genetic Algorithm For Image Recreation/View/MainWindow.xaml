<mah:MetroWindow x:Class="Genetic_Algorithm_For_Image_Recreation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Genetic_Algorithm_For_Image_Recreation"
        xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        
        Dialog:DialogParticipation.Register="{Binding}"
  
        mc:Ignorable="d"
        Title="Genetic Algorithm For Image Reconstrution" 
                 Height="500" 
                 Width="1000"
                 
                 WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".5*"/>
            <ColumnDefinition Width=".5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        
        <!--Status prgoress-->

        <TextBlock x:Name="tbStatus" Text="{Binding StatusText}" FontSize="15" Width="Auto" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="tbProgress" Text="{Binding ProgressText}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <mah:MetroProgressBar
                x:Name="ProgressBar"
                Value="{Binding ProgressValue}"
                Maximum="{Binding ProgressMaximumValue}"
                BorderThickness="0.5"
                Margin="10"
                BorderBrush="Black"
                Foreground="GreenYellow"
            />
        </StackPanel>
        
        <!-- Srouce Image -->
        <Image
            Grid.Row="1"
            Grid.RowSpan="2"
            x:Name="srcImage"
            Stretch="Uniform"
            Source="{Binding SourceImage}"
            />
        
        <!-- Algorithm Output -->
        <Image
            Grid.Row="1"
            Grid.Column="1"
            Grid.RowSpan="2"
            x:Name="resultImage"
            Height="{Binding ActualHeight, ElementName=srcImage}"
            Width="{Binding ActualWidth, ElementName=srcImage}"
            Source="{Binding ResultImage}"
            Stretch="Uniform"/>

        <Grid
            Grid.Row="3"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnToggleRun"
                Content="{Binding StartButtonText}"
                Width="{Binding ActualWidth, ElementName=btnLoadImage}"
                Height="50"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Command="{Binding ToggleRunCommand}"
                />

            <Button
                Grid.Column="1"
                x:Name="btnLoadImage"
                Content="{Binding SelectImageButtonText }"
                Width="auto"
                Height="50"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Command="{Binding LoadImageCommand}"
                />

            <Button
                Grid.Column="2"
                x:Name="btnSettings"
                Content="{Binding SettingButtonText}"
                Width="{Binding ActualWidth, ElementName=btnLoadImage}"
                Height="50"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Command="{Binding OpenSettingsCommand}"
                />
        </Grid>


        <Grid Grid.Row="3" Grid.Column="1">
            <Button
                x:Name="btnSaveResult"
                Content="{Binding SaveResultButtonText}"
                Height="50"
                Width="{Binding ActualWidth, ElementName=btnLoadImage}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Command="{Binding SaveResultCommand}"
                />


        </Grid>



    </Grid>
</mah:MetroWindow>