<Window x:Class="Genetic_Algorithm_For_Image_Recreation.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Genetic_Algorithm_For_Image_Recreation.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="SettingsWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height=".25*"/>
                <RowDefinition Height=".15*"/>
                <RowDefinition Height=".6*"/>
            </Grid.RowDefinitions>


            <StackPanel>
                <TextBlock x:Name="tbShape" Text="Shape:" Margin="10"/>

                <StackPanel>
                    <RadioButton x:Name="rbRectangle" Command="{Binding RectangleCheckedCommand}" IsChecked="True" Content="Rectangle"/>
                    <RadioButton x:Name="rbEllipse" Command="{Binding EllipseCheckedCommand}" Content="Ellipse"/>
                    <RadioButton x:Name="rbTriangle" Command="{Binding TriangleCheckedCommand}" Content="Triangle"/>
                </StackPanel>
            </StackPanel>


            <StackPanel Grid.Row="1">
                <TextBlock x:Name="tbSelection" Text="Selection type:"/>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="rbTournamentSelection" Command="{Binding TournamentCheckedCommand}" Content="Tournament"/>
                </StackPanel>
            </StackPanel>


            <StackPanel Grid.Row="2">
                <TextBlock x:Name="tbParameters" Text="Algorithm Parameters"/>
                
                <Label Target="{Binding ElementName=nrOfPopulation}" Content="Population size:"/>
                <mah:NumericUpDown x:Name="nrOfPopulation"
                                   Value="{Binding AlgorithmConfig.sizeOfPopulation }"
                                   Minimum="{Binding PopulationMinimum}"
                                   Maximum="{Binding PopulationMaximum}"
                                   NumericInputMode="Numbers"
                                   HorizontalAlignment="Left"
                                   Width="100"/>

                <Label Target="{Binding ElementName=nrOfGenes}" Content="Number of genes:"/>
                <mah:NumericUpDown Name="nrOfGenes"
                                   Value="{Binding AlgorithmConfig.numberOfGenes}"
                                   Minimum="{Binding GenesMinimum}"
                                   Maximum="{Binding GenesMaximum}"
                                   NumericInputMode="Numbers" 
                                   HorizontalAlignment="Left"
                                   Width="100"/>

                <Label Target="{Binding ElementName=nrOfIteration}" Content="Number of iterations"/>
                <mah:NumericUpDown Name="nrOfIteration"
                                   Value="{Binding AlgorithmConfig.numberOfIterations}"
                                   Minimum="{Binding IterationsMinimum}"
                                   Maximum="{Binding IterationsMaximum}"
                                   NumericInputMode="Numbers"
                                   HorizontalAlignment="Left" 
                                   Width="100"/>


                <Label Target="{Binding ElementName=nrOfGeneScale}" Content="Size of gene (shape) in %:"/>
                <mah:NumericUpDown Name="nrOfGeneScale"
                                   Value="{Binding AlgorithmConfig.maxGeneScale}"
                                   Minimum="{Binding SizeMinimum}"
                                   Maximum="{Binding SizeMaximum}"
                                   NumericInputMode="Numbers"
                                   HorizontalAlignment="Left" 
                                   Width="100"/>

                <Button x:Name="btnSubmit" Command="{Binding SubmitCommand}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
